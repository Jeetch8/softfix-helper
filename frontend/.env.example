# MongoDB
MONGODB_URI=mongodb+srv://your-user:your-password@cluster.mongodb.net/softfix_helper?appName=Cluster0

# Backblaze B2 (S3-compatible storage)
BACKBLAZE_BUCKET_NAME=softfix
BACKBLAZE_ENDPOINT_URL=https://s3.us-east-005.backblazeb2.com
BACKBLAZE_REGION=us-east-005
BACKBLAZE_KEY_ID=your-key-id
BACKBLAZE_APPLICATION_KEY=your-application-key

# Google AI / Gemini
GEMINI_API_KEY=your-gemini-api-key
USE_VERTEX_AI=false
GCP_PROJECT=your-gcp-project
GCP_LOCATION=your-gcp-location

# OpenAI / Compatible endpoints
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: TTS model
TTS_MODEL=gemini-2.5-pro-preview-tts
